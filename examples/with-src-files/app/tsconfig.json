{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@acme/ui-lib/css": ["../generated/css"],
      "@acme/ui-lib/recipes": ["../generated/recipes"],
      "@acme/ui-lib/patterns": ["../generated/patterns"],
      "@acme/ui-lib/jsx": ["../generated/jsx"],
      "@acme/ui-lib/css/*": ["../generated/css/*"],
      "@acme/ui-lib/recipes/*": ["../generated/recipes/*"],
      "@acme/ui-lib/patterns/*": ["../generated/patterns/*"],
      "@acme/ui-lib/jsx/*": ["../generated/jsx/*"]
    }
    //
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
